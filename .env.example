# ─────────────────────────────────────────────────────────────────────────────
# TEMPLATE ONLY — never put real values here, this file is committed.
# Copy to `.env` and fill that in. Restart `npm run dev` after changing.
# ─────────────────────────────────────────────────────────────────────────────

# CLIENT (Firebase web config — public by design, not secrets).
# Firebase console → Project settings → General → Your apps → SDK setup.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ─────────────────────────────────────────────────────────────────────────────
# SERVER (set these on your host, NOT in the client bundle).
# ─────────────────────────────────────────────────────────────────────────────

# Same project id as above. The API verifies the browser's Firebase ID token
# against it. If this is unset every send is rejected with 401 — by design.
FIREBASE_PROJECT_ID=your-project

# SMTP — mail is sent straight from your own mailbox, no third-party service.
# Gmail: enable 2-Step Verification, then create an App Password
# (Google Account -> Security -> App passwords). The normal account password
# will NOT work. These are secrets.
SMTP_USER=invisos99@gmail.com
SMTP_PASS=

# Optional — defaults are Gmail (smtp.gmail.com:465, implicit TLS).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# MAIL_FROM=Invisos <invisos99@gmail.com>
